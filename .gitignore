*.sln
*.sw?

# Replit-specific files
attached_assets/
.replit
replit.nix

# Replit global tool cache (dotslash, eas-cli, npm, etc.) — must never be uploaded to EAS Build
.cache/

# Generated PWA service-worker/build artifacts (regenerated by the dev server; not source)
frontend/dev-dist/

# Ship the pre-built landing site to Railway (its builder cannot reliably
# run npm ci); rebuild with `cd landing && npm run build` before pushing.
!landing/dist/
!landing/dist/**
