{
  "expo": {
    "name": "Earnings Ninja",
    "slug": "earnings-ninja",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/d0be520b-c231-4a05-9f34-24fd35a24935"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "scheme": "earningsninja",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.earningsninja.app",
      "buildNumber": "10",
      "appleTeamId": "77827G7735",
      "infoPlist": {
        "NSCameraUsageDescription": "Earnings Ninja needs camera access to photograph receipts for expense tracking.",
        "NSPhotoLibraryUsageDescription": "Earnings Ninja needs photo library access to attach receipt images to your expenses.",
        "NSPhotoLibraryAddUsageDescription": "Earnings Ninja needs permission to save receipt photos to your library.",
        "NSLocationWhenInUseUsageDescription": "Earnings Ninja uses your location to automatically track trip mileage while you are delivering.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.finance"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.earningsninja.shared"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.earningsninja.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Earnings Ninja needs photo library access to attach receipt images to your expenses.",
          "cameraPermission": "Earnings Ninja needs camera access to photograph receipts for expense tracking."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker",
      "./plugins/withLocalNotificationsOnly",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.earningsninja.app.widget",
                  "targetName": "EarningsWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.earningsninja.shared"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "d0be520b-c231-4a05-9f34-24fd35a24935"
      }
    },
    "owner": "inventor01"
  }
}
