modules = ["python-3.11", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0", "python_log_in_with_replit:1.0.0", "python_database:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Landing Site"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn backend.app:app --host 0.0.0.0 --port 8000 --reload"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Expo Mobile"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd earnings-ninja-expo && npx expo start --tunnel"

[[workflows.workflow]]
name = "Landing Site"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd landing && npm run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[nix]
channel = "stable-25_05"
packages = ["cargo", "imagemagick", "libiconv", "libxcrypt", "rustc", "zip"]

[userenv]

[userenv.shared]
PRELAUNCH_ACCESS_CODE = "en2025"
JWT_SECRET_KEY = "076e698a2ede6418af974661a21247dea031dd4c6008dcb551c3c1331f1573f4f9dc5896c6a65b5a928c1a36f03d2987"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "uvicorn backend.app:app --host 0.0.0.0 --port 5000"]
build = ["bash", "-c", "cd frontend && npm run build"]
