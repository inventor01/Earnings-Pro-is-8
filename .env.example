# Backend Configuration
PORT=8000
DATABASE_URL=sqlite:///./driver_ledger.db

# For PostgreSQL on Railway, use:
# DATABASE_URL=postgresql://user:password@host:port/database

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
SESSION_SECRET=your_session_secret_here

# Auth secrets — NEVER put real values in tracked files or repl config.
# Set these via the secrets manager (Replit Secrets in dev, Railway Variables in prod).
# Generate JWT_SECRET_KEY with: python -c 'import secrets; print(secrets.token_hex(48))'
# Rotation runbook: docs/jwt-secret-rotation.md
JWT_SECRET_KEY=
PRELAUNCH_ACCESS_CODE=

# Android closed-beta funnel
# Keep this token private; a Railway cron job uses it to process approved tester invites.
BETA_INVITE_CRON_TOKEN=
# Minimum wait after signup before the tester-link email may send.
BETA_INVITE_DELAY_MINUTES=60

# OAuth Credentials (optional - for Uber/Shipt platform integration)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
SHIPT_CLIENT_ID=
SHIPT_CLIENT_SECRET=

# Frontend Configuration
VITE_API_BASE=http://localhost:8000
COST_PER_MILE_DEFAULT=0.35
